{
  "description": "Políticas do Córtex aplicadas por hook: bloqueia código que registra em log ou devolve CPF/e-mail sem mascaramento.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/checar-pii.mjs"],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
